# ── Copy this file to .env and fill in your values ───────────────────────────
# NEVER commit .env — it is listed in .gitignore

# ── Required ─────────────────────────────────────────────────────────────────

# Google Gemini API key — get one free at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ── Recommended ──────────────────────────────────────────────────────────────

# USDA FoodData Central API key — free at https://api.nal.usda.gov/signup
# Without this, the app falls back to the shared DEMO_KEY (often rate-limited).
# Personal key gives 3,600 requests/hour.
USDA_API_KEY=your_usda_api_key_here

# ── Production only (Render backend service) ─────────────────────────────────

# Comma-separated list of allowed frontend origins for CORS.
# Set this to your Render frontend URL, e.g.:
#   ALLOWED_ORIGINS=https://aldi-meal-planner.onrender.com
# Defaults to localhost dev origins when not set.
ALLOWED_ORIGINS=https://your-frontend.onrender.com
